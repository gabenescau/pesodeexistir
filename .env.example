VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# AbacatePay (pagamentos)
# Crie sua conta em https://abacatepay.com e gere uma API Key
ABACATEPAY_API_KEY=your-abacatepay-api-key
# Webhook secret gerado ao criar o webhook no painel AbacatePay
ABACATEPAY_WEBHOOK_SECRET=your-webhook-secret
# Chave de serviço do Supabase (para o webhook atualizar subscriptions)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key