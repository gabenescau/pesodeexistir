# ============================================================================
# OPE Club — variaveis de ambiente
# Copie para `.env` (desenvolvimento local). NUNCA commite valores reais:
# `.gitignore` ja ignora `.env`, `.env.local`, etc. Este exemplo usa apenas
# placeholders.
#
# No Vercel: configure as mesmas variaveis no painel do projeto. Os serverless
# functions (api/*) leem process.env em runtime; o cliente recebe somente as
# variaveis prefixadas com VITE_/NEXT_PUBLIC_ (embutidas no bundle).
# ============================================================================

# ---- Supabase --------------------------------------------------------------
# Cliente: URL e chave publica (publishable/anon) do projeto Supabase.
# A chave vai ao bundle — use apenas a publishable/anon, nunca a service role.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sua-chave-publishable-ou-anon
# Fallbacks legados (usados so se as VITE_* acima nao existirem).
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Servidor (api/*): URL e chaves de servico. A SERVICE_ROLE jamais vai ao
# bundle. SUPABASE_SECRET_KEY e alias de SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key
SUPABASE_SECRET_KEY=sua-service-role-key
SUPABASE_PUBLISHABLE_KEY=sua-chave-publishable

# ---- Seguranca / rate limit ------------------------------------------------
# CORS: origens permitidas para as APIs serverless (separadas por virgula).
CORS_ALLOWED_ORIGINS=https://pesodeexistir.online,http://localhost:5173
# Segredo usado no rate limit compartilhado (server + Supabase RPC).
RATE_LIMIT_SECRET=segredo-aleatorio-forte
# O rate limit e FAIL-CLOSED por padrao. Seta "true" APENAS como escape manual
# consciente para reabrir quando o RPC de rate limit falhar (nao recomendado).
# RATE_LIMIT_FAIL_OPEN=true

# ---- Site (opcional; o Vercel resolve sozinho em producao) -----------------
# Usado como base da URL nos redirects/links de pagamento.
# NEXT_PUBLIC_SITE_URL=https://pesodeexistir.online
