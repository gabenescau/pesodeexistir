# Client-side Supabase values (safe to expose through VITE_*)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only Supabase values. Never use these with VITE_ or NEXT_PUBLIC_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SECRET_KEY=your-supabase-secret-key

# Legacy Stripe variables: keep only until the existing Stripe customer is canceled.
STRIPE_SECRET_KEY=sk_test_replace-me
STRIPE_WEBHOOK_SECRET=whsec_replace-me
# Optional: Stripe Dashboard configuration with only card enabled.
STRIPE_PAYMENT_METHOD_CONFIGURATION_ID=pmc_replace-me

# Server-only Price IDs, one recurring Price for each plan and cycle.
STRIPE_PRICE_LEITOR_MONTHLY=price_replace-me
STRIPE_PRICE_LEITOR_ANNUAL=price_replace-me
STRIPE_PRICE_PENSADOR_MONTHLY=price_replace-me
STRIPE_PRICE_PENSADOR_ANNUAL=price_replace-me

# Server-only Asaas integration. Never prefix these with VITE_ or expose them to the browser.
ASAAS_ENVIRONMENT=sandbox
ASAAS_API_KEY=replace-with-asaas-access-token
ASAAS_API_BASE_URL=https://api-sandbox.asaas.com/v3
ASAAS_WEBHOOK_TOKEN=replace-with-a-long-random-webhook-token

# Public app URL used in provider success/cancel URLs.
APP_URL=https://app.pesodeexistir.online

# Required by the server-side rate limiter.
RATE_LIMIT_SECRET=replace-me-with-a-long-random-secret
